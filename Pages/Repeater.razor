@page "/"
@using System.Text
@using Repetidor.Services
@inject IRepetidorService RepetidorService
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>🔁 Repetidor de Frases</PageTitle>
<h3>🔁 Repetidor de Frases</h3>

<div class="container">
    <h3>🔁 Repetidor de Frases com Stream</h3>

    <div class="form-grid">
        <div class="input-group">
            <label>📝 Frase:</label>
            <input @bind="frase" placeholder="Digite uma frase..." />
        </div>
        <div class="input-group">
            <label>🔢 Número de repetições:</label>
            <input type="number" @bind="vezes" min="1" max="5000" />
        </div>
        <div class="input-group">
            <label>➗ Separador:</label>
            <select @bind="separador">
                <option value="\n">Nova linha</option>
                <option value=", ">Vírgula + espaço</option>
                <option value=" ">Espaço</option>
                <option value=";">Ponto e vírgula</option>
            </select>
        </div>
        <div class="input-group checkbox-group">
            <input type="checkbox" @bind="numerar" />
            <label>🔢 Numerar linhas</label>
        </div>
    </div>

    <div class="button-group">
        <button class="btn btn-primary" @onclick="GerarAsync" disabled="@gerando">
            @(gerando ? "⏳ Gerando..." : "🚀 Repetir")
        </button>
        <button class="btn btn-secondary" @onclick="Limpar">🗑️ Limpar</button>
    </div>

    <div class="result-area">
        <div class="result-header">
            <div class="action-buttons">
                @if (!string.IsNullOrEmpty(resultadoFinal))
                {
                    <button class="btn btn-outline btn-sm" @onclick="CopiarResultado">📋 Copiar</button>
                    <button class="btn btn-outline btn-sm" @onclick="ExportarTxt">💾 Exportar .txt</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(resultadoFinal))
            {
                <span class="badge">📏 Caracteres: @resultadoFinal.Length</span>
            }
        </div>
        <div class="output-box">
            @if (gerando)
            {
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <span>Gerando @vezes repetições (streaming ativo)...</span>
                </div>
            }
            else
            {
                <pre>@resultadoParcial</pre>
            }
        </div>
    </div>
    @if (historico.Any())
    {
        <div class="history-section">
            <div class="history-title">
                📜 Últimos 5 usos (clique para recarregar)
            </div>
            <div class="history-list">
                @foreach (var item in historico)
                {
                    <div class="history-item" @onclick="() => CarregarDoHistorico(item)">
                        <strong>@item.Frase</strong> – @item.Vezes vez(es)
                        <div class="history-meta">
                            @(item.Numerar ? "Numerado" : "Não numerado") · Separador: @item.Separador
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>


